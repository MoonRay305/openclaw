{
  "name": "@doublerook/openclaw-voice-field-router",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic OpenClaw inbound router for Double Rook Voice Field",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.6.11"
    },
    "runtimeExtensions": [
      "./dist/index.mjs"
    ],
    "build": {
      "openclawVersion": "2026.6.11"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts"
  },
  "devDependencies": {
    "openclaw": "workspace:*",
    "tsdown": "0.22.1"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.11"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
}
